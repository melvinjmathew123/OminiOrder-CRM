# Application Port
PORT=4000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mom_crm?schema=public"

# Shopify Store Credentials
# Store domain (e.g. your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN="your-development-store.myshopify.com"

# Shopify Admin API Access Token (shpat_xxxxxxxxxxxxxxxxxxxx)
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shopify API Version (defaults to 2024-01)
SHOPIFY_API_VERSION="2024-01"

# Shopify Webhook Secret (from App settings or Notifications / Webhooks)
# Used for X-Shopify-Hmac-Sha256 cryptographic verification
SHOPIFY_WEBHOOK_SECRET="shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
